# ──────────────────────────────────────────────────────────────
# Variáveis de Ambiente — copie este arquivo pra .env
#
#   cp .env.example .env
#
# O Pydantic Settings carrega automaticamente do .env
# ──────────────────────────────────────────────────────────────

# --- Banco de Dados (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://revisor:revisor123@localhost:5432/revisor_ia

# --- Ollama (LLM local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELO_LLM=llama3.1
OLLAMA_MODELO_EMBEDDING=nomic-embed-text

# --- LangSmith (Observabilidade — opcional) ---
# Crie conta em: https://smith.langchain.com
# Gere uma API key e cole aqui
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=revisor-ia

# --- Feature Flags (liga/desliga funcionalidades) ---
FF_LANGSMITH_ATIVO=false
FF_RAGAS_ATIVO=true
FF_DEEPEVAL_ATIVO=true
FF_LOOP_REGENERACAO=true
FF_MAX_TENTATIVAS=3
FF_RAG_ATIVO=true
FF_RAG_TOP_K=5
FF_TESTE_AB_ATIVO=true
